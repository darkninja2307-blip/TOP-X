# Copy this file to ".env" for running on your own PC. For Vercel, put these in Project > Settings > Environment Variables instead.
SECRET_KEY=put-a-long-random-string-here

# ---- Database ----
# Local PC (MySQL):   DB_HOST=localhost  DB_PORT=3306  DB_USER=root  DB_PASS=  DB_NAME=showroom  DB_SSL=0
# TiDB Cloud (free):  DB_HOST=gateway01.xx.prod.aws.tidbcloud.com  DB_PORT=4000  DB_USER=xxxx.root  DB_NAME=test  DB_SSL=1
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=showroom
DB_SSL=0

# ---- Discord developer portal > your app > OAuth2 ----
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5000/auth/discord/callback
# Your Discord user ID(s), comma separated = admins
ADMIN_DISCORD_IDS=

# ---- Image storage (needed on Vercel; leave empty on your own PC to save into /uploads) ----
# From Cloudinary dashboard > API Keys:  cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
